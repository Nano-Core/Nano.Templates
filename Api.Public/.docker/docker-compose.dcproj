<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <DockerLaunchBrowser>false</DockerLaunchBrowser>
    <DockerServiceUrl>http://localhost:{ServicePort}/docs</DockerServiceUrl>
    <DockerServiceName>$(ProjectName)</DockerServiceName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="docker-compose.yml" />
    <None Include="publish-dependencies.ps1" />
    <None Include=".env" />
  </ItemGroup>

  <ItemGroup>
    <DependentServiceSources Include="..\..\Svc.Accounts\Svc.Accounts\**\*.cs;..\..\Svc.Accounts\Svc.Accounts\Svc.Accounts.csproj;..\..\Svc.Accounts\Svc.Accounts.Models\**\*.cs;..\..\Svc.Accounts\Svc.Accounts.Models\Svc.Accounts.Models.csproj" Exclude="..\..\Svc.Accounts\Svc.Accounts\bin\**;..\..\Svc.Accounts\Svc.Accounts\obj\**;..\..\Svc.Accounts\Svc.Accounts.Models\bin\**;..\..\Svc.Accounts\Svc.Accounts.Models\obj\**" />
    <DependentServiceSources Include="..\..\Svc.Locations\Svc.Locations\**\*.cs;..\..\Svc.Locations\Svc.Locations\Svc.Locations.csproj;..\..\Svc.Locations\Svc.Locations.Models\**\*.cs;..\..\Svc.Locations\Svc.Locations.Models\Svc.Locations.Models.csproj;..\..\Svc.Locations\Svc.Locations.Events\**\*.cs;..\..\Svc.Locations\Svc.Locations.Events\Svc.Locations.Events.csproj" Exclude="..\..\Svc.Locations\Svc.Locations\bin\**;..\..\Svc.Locations\Svc.Locations\obj\**;..\..\Svc.Locations\Svc.Locations.Models\bin\**;..\..\Svc.Locations\Svc.Locations.Models\obj\**;..\..\Svc.Locations\Svc.Locations.Events\bin\**;..\..\Svc.Locations\Svc.Locations.Events\obj\**" />
    <DependentServiceSources Include="..\..\Svc.Emailing\Svc.Emailing\**\*.cs;..\..\Svc.Emailing\Svc.Emailing\Svc.Emailing.csproj;..\..\Svc.Emailing\Svc.Emailing.Models\**\*.cs;..\..\Svc.Emailing\Svc.Emailing.Models\Svc.Emailing.Models.csproj" Exclude="..\..\Svc.Emailing\Svc.Emailing\bin\**;..\..\Svc.Emailing\Svc.Emailing\obj\**;..\..\Svc.Emailing\Svc.Emailing.Models\bin\**;..\..\Svc.Emailing\Svc.Emailing.Models\obj\**" />
    <DependentServiceSources Include="..\..\Svc.Places\Svc.Places\**\*.cs;..\..\Svc.Places\Svc.Places\Svc.Places.csproj;..\..\Svc.Places\Svc.Places.Models\**\*.cs;..\..\Svc.Places\Svc.Places.Models\Svc.Places.Models.csproj" Exclude="..\..\Svc.Places\Svc.Places\bin\**;..\..\Svc.Places\Svc.Places\obj\**;..\..\Svc.Places\Svc.Places.Models\bin\**;..\..\Svc.Places\Svc.Places.Models\obj\**" />
  </ItemGroup>

  <Target Name="PublishDependentServices"
          BeforeTargets="DockerPrepareForBuild"
          Inputs="@(DependentServiceSources)"
          Outputs="$(MSBuildProjectDirectory)\bin\publish-dependencies.stamp">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\publish-dependencies.ps1&quot; -Configuration $(Configuration)" />
  </Target>
</Project>
