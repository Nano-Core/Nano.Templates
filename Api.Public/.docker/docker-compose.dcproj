<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <DockerLaunchBrowser>false</DockerLaunchBrowser>
    <DockerServiceUrl>http://localhost:{ServicePort}/docs</DockerServiceUrl>
    <DockerServiceName>$(ProjectName)</DockerServiceName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="docker-compose.yml" />
    <None Include="publish-dependencies.ps1" />
    <None Include=".env" />
  </ItemGroup>

  <ItemGroup>
    <SvcAccountsSources Include="..\..\Svc.Accounts\Svc.Accounts\**\*.cs;..\..\Svc.Accounts\Svc.Accounts\**\*.json;..\..\Svc.Accounts\Svc.Accounts\Svc.Accounts.csproj;..\..\Svc.Accounts\Svc.Accounts.Models\**\*.cs;..\..\Svc.Accounts\Svc.Accounts.Models\Svc.Accounts.Models.csproj" Exclude="..\..\Svc.Accounts\Svc.Accounts\bin\**;..\..\Svc.Accounts\Svc.Accounts\obj\**;..\..\Svc.Accounts\Svc.Accounts.Models\bin\**;..\..\Svc.Accounts\Svc.Accounts.Models\obj\**" />
    <SvcLocationsSources Include="..\..\Svc.Locations\Svc.Locations\**\*.cs;..\..\Svc.Locations\Svc.Locations\**\*.json;..\..\Svc.Locations\Svc.Locations\Svc.Locations.csproj;..\..\Svc.Locations\Svc.Locations.Models\**\*.cs;..\..\Svc.Locations\Svc.Locations.Models\Svc.Locations.Models.csproj;..\..\Svc.Locations\Svc.Locations.Events\**\*.cs;..\..\Svc.Locations\Svc.Locations.Events\Svc.Locations.Events.csproj" Exclude="..\..\Svc.Locations\Svc.Locations\bin\**;..\..\Svc.Locations\Svc.Locations\obj\**;..\..\Svc.Locations\Svc.Locations.Models\bin\**;..\..\Svc.Locations\Svc.Locations.Models\obj\**;..\..\Svc.Locations\Svc.Locations.Events\bin\**;..\..\Svc.Locations\Svc.Locations.Events\obj\**" />
    <SvcEmailingSources Include="..\..\Svc.Emailing\Svc.Emailing\**\*.cs;..\..\Svc.Emailing\Svc.Emailing\**\*.json;..\..\Svc.Emailing\Svc.Emailing\Svc.Emailing.csproj;..\..\Svc.Emailing\Svc.Emailing.Models\**\*.cs;..\..\Svc.Emailing\Svc.Emailing.Models\Svc.Emailing.Models.csproj" Exclude="..\..\Svc.Emailing\Svc.Emailing\bin\**;..\..\Svc.Emailing\Svc.Emailing\obj\**;..\..\Svc.Emailing\Svc.Emailing.Models\bin\**;..\..\Svc.Emailing\Svc.Emailing.Models\obj\**" />
    <SvcPlacesSources Include="..\..\Svc.Places\Svc.Places\**\*.cs;..\..\Svc.Places\Svc.Places\**\*.json;..\..\Svc.Places\Svc.Places\Svc.Places.csproj;..\..\Svc.Places\Svc.Places.Models\**\*.cs;..\..\Svc.Places\Svc.Places.Models\Svc.Places.Models.csproj" Exclude="..\..\Svc.Places\Svc.Places\bin\**;..\..\Svc.Places\Svc.Places\obj\**;..\..\Svc.Places\Svc.Places.Models\bin\**;..\..\Svc.Places\Svc.Places.Models\obj\**" />
  </ItemGroup>

  <Target Name="PublishSvcAccounts"
          BeforeTargets="DockerPrepareForBuild"
          Inputs="@(SvcAccountsSources)"
          Outputs="$(MSBuildProjectDirectory)\bin\publish-svc-accounts.stamp">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\publish-dependencies.ps1&quot; -Configuration $(Configuration) -Project &quot;..\..\Svc.Accounts\Svc.Accounts\Svc.Accounts.csproj&quot; -StampName publish-svc-accounts.stamp" />
  </Target>

  <Target Name="PublishSvcLocations"
          BeforeTargets="DockerPrepareForBuild"
          Inputs="@(SvcLocationsSources)"
          Outputs="$(MSBuildProjectDirectory)\bin\publish-svc-locations.stamp">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\publish-dependencies.ps1&quot; -Configuration $(Configuration) -Project &quot;..\..\Svc.Locations\Svc.Locations\Svc.Locations.csproj&quot; -StampName publish-svc-locations.stamp" />
  </Target>

  <Target Name="PublishSvcEmailing"
          BeforeTargets="DockerPrepareForBuild"
          Inputs="@(SvcEmailingSources)"
          Outputs="$(MSBuildProjectDirectory)\bin\publish-svc-emailing.stamp">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\publish-dependencies.ps1&quot; -Configuration $(Configuration) -Project &quot;..\..\Svc.Emailing\Svc.Emailing\Svc.Emailing.csproj&quot; -StampName publish-svc-emailing.stamp" />
  </Target>

  <Target Name="PublishSvcPlaces"
          BeforeTargets="DockerPrepareForBuild"
          Inputs="@(SvcPlacesSources)"
          Outputs="$(MSBuildProjectDirectory)\bin\publish-svc-places.stamp">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\publish-dependencies.ps1&quot; -Configuration $(Configuration) -Project &quot;..\..\Svc.Places\Svc.Places\Svc.Places.csproj&quot; -StampName publish-svc-places.stamp" />
  </Target>
</Project>
